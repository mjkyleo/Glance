{
  "name": "glance",
  "version": "1.0.6",
  "description": "词根助记 × 词性详解 × 专项分类的英语词汇学习应用（Windows / Android）。",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/dev-start.js",
    "start:win": "if not exist \"%APPDATA%\\glance\" mkdir \"%APPDATA%\\glance\" & electron . --no-sandbox",
    "build": "electron-builder",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "vendor:fsrs": "node scripts/vendor-ts-fsrs.mjs",
    "contrast:fsrs": "node scripts/fsrs-contrast.mjs"
  },
  "build": {
    "appId": "com.glance.app",
    "productName": "Glance",
    "publish": {
      "provider": "github",
      "owner": "mjkyleo",
      "repo": "Glance"
    },
    "files": [
      "**/*",
      "!node_modules/electron-builder/**/*",
      "!android/**/*",
      "!capacitor.config.json",
      "!.scratch/**/*",
      "!scripts/**/*",
      "!data/**/*",
      "!app/dev/**/*",
      "!app/js/vendor/**/*",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/app-icon.ico",
      "artifactName": "glance-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "assets/icons/app-icon.icns",
      "artifactName": "glance-setup-${version}.${ext}"
    }
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "electron": "^31.0.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "ts-fsrs": "^6.0.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.1.0",
    "electron-updater": "^6.6.2"
  }
}
